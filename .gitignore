# Raw data and generated outputs (not tracked, see CLAUDE.md)
data/*
!data/.gitkeep
# Provenance manifest is committed on purpose (see src/manifest.py). Must be its own comment
# line, not trailing the pattern below — gitignore has no inline-comment syntax, so
# "!data/manifest.json   # ..." was previously matched literally and never actually un-ignored
# the file (confirmed via `git log --all -- data/manifest.json`: zero commits, ever).
!data/manifest.json
outputs/*
!outputs/.gitkeep
# The pipeline's PNGs ARE committed: README.md embeds them, and while they were ignored every
# README image rendered broken on GitHub (found 2026-09-30 — nothing under outputs/ had ever
# been committed). `python -m src.pipeline` regenerates them; a diff here means a model or plot
# output actually changed.
!outputs/*.png

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Editor/assistant settings are per-machine (the old .vscode/settings.json held absolute
# interpreter paths for one laptop), so they stay local.
.vscode/
.claude/

# OS
.DS_Store
Thumbs.db
